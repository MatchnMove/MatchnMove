generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MOVER
  CLEANER
  ADMIN
}

enum CleaningLocation {
  MOVE_OUT
  MOVE_IN
}

enum CleaningLeadStatus {
  NEW
  NOTIFIED
  VIEWED
  PURCHASED
  CONTACTED
  WON
  LOST
  ARCHIVED
}

enum CleanerChargeStatus {
  PENDING
  INVOICED
  PAID
  FAILED
  VOID
}

enum CleanerInvoiceStatus {
  UPCOMING
  OPEN
  SENT
  PAID
  OVERDUE
  VOID
}

enum LeadStatus {
  NEW
  NOTIFIED
  VIEWED
  PURCHASED
  CONTACTED
  WON
  LOST
  ARCHIVED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  WAIVED
}

enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
  SIGN_IN_CODE
}

enum ReviewModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmailDeliveryStatus {
  QUEUED
  SENDING
  SENT
  FAILED
}

enum SpreadsheetDeliveryStatus {
  QUEUED
  SENDING
  SYNCED
  FAILED
}

model User {
  id                      String                  @id @default(cuid())
  name                    String?
  email                   String                  @unique
  passwordHash            String
  emailVerifiedAt         DateTime?
  role                    UserRole                @default(MOVER)
  preferredLocale         String                  @default("en-NZ")
  adminMfaSecret          String?
  adminMfaEnabledAt       DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  adminRole               AdminRole?
  adminDisabledAt         DateTime?
  sessionVersion          Int                     @default(0)
  lastSignInAt            DateTime?
  canSendRecruitment      Boolean                 @default(false)
  canViewRecruitmentLeads Boolean                 @default(false)
  assignedProspects       MoverProspect[]
  recruitmentTasks        RecruitmentTask[]
  outreachMessages        OutreachMessage[]
  moverCompany            MoverCompany?
  cleanerCompany          CleanerCompany?
  authTokens              AuthToken[]
  phoneVerificationCodes  PhoneVerificationCode[]
}

model CleanerCompany {
  id                  String                 @id @default(cuid())
  userId              String                 @unique
  stripeCustomerId    String?                @unique
  companyName         String
  businessDescription String?                @db.Text
  contactPerson       String
  phone               String
  nzbn                String?
  yearsOperating      Int?
  logoUrl             String?
  serviceAreas        String[]
  status              String                 @default("PENDING")
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  user                User                   @relation(fields: [userId], references: [id])
  leads               CleaningLead[]
  purchases           CleaningLeadPurchase[]
  invoices            CleanerInvoice[]

  @@index([status, updatedAt])
}

model MoverCompany {
  id                           String                  @id @default(cuid())
  userId                       String                  @unique
  stripeCustomerId             String?                 @unique
  companyName                  String
  businessDescription          String?
  nzbn                         String?
  nzbnVerificationStatus       String                  @default("UNVERIFIED")
  nzbnVerifiedAt               DateTime?
  nzbnRegisteredName           String?
  nzbnEntityStatus             String?
  nzbnVerificationSource       String?
  nzbnVerificationError        String?                 @db.Text
  operatingRegion              String?
  movingServices               String[]                @default([])
  yearsOperatingVerifiedAt     DateTime?
  legacyPublicProfile          Boolean                 @default(false)
  profileReviewedAt            DateTime?
  yearsOperating               Int?
  logoUrl                      String?
  serviceAreas                 String[]
  status                       String                  @default("ACTIVE")
  contactPerson                String?
  phone                        String?
  phoneVerifiedAt              DateTime?
  authorizedRepresentativeName String?
  authorizedRepresentativeRole String?
  authorityDeclaredAt          DateTime?
  baseLeadPrice                Int                     @default(2000)
  averageRating                Float                   @default(0)
  totalReviewCount             Int                     @default(0)
  fiveStarCount                Int                     @default(0)
  fourStarCount                Int                     @default(0)
  threeStarCount               Int                     @default(0)
  twoStarCount                 Int                     @default(0)
  oneStarCount                 Int                     @default(0)
  communicationAverage         Float                   @default(0)
  punctualityAverage           Float                   @default(0)
  careOfBelongingsAverage      Float                   @default(0)
  professionalismAverage       Float                   @default(0)
  valueForMoneyAverage         Float                   @default(0)
  recommendationRate           Float                   @default(0)
  leaderboardEligible          Boolean                 @default(false)
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
  user                         User                    @relation(fields: [userId], references: [id])
  documents                    MoverDocument[]
  leads                        Lead[]
  reviews                      Review[]
  reviewSurveyInvites          ReviewSurveyInvite[]
  phoneVerificationCodes       PhoneVerificationCode[]
  verificationAudits           VerificationAudit[]
  pushSubscriptions            MoverPushSubscription[]
  recruitmentProspect          MoverProspect?

  @@index([status, updatedAt])
  @@index([nzbnVerificationStatus, updatedAt])
}

model MoverDocument {
  id                   String       @id @default(cuid())
  moverCompanyId       String
  type                 String
  fileName             String?
  mimeType             String?
  fileSize             Int?
  fileUrl              String?
  storageKey           String?      @unique
  sha256               String?
  detectedMimeType     String?
  scanStatus           String       @default("PENDING")
  expiresAt            DateTime?
  expiryReminderSentAt DateTime?
  verificationStatus   String       @default("PENDING_REVIEW")
  verificationNote     String?      @db.Text
  reviewedAt           DateTime?
  reviewedBy           String?
  createdAt            DateTime     @default(now())
  moverCompany         MoverCompany @relation(fields: [moverCompanyId], references: [id])

  @@index([moverCompanyId, createdAt])
  @@index([verificationStatus, createdAt])
  @@index([expiresAt, expiryReminderSentAt])
}

model PhoneVerificationCode {
  id             String       @id @default(cuid())
  userId         String
  moverCompanyId String
  phone          String
  codeHash       String
  expiresAt      DateTime
  consumedAt     DateTime?
  attempts       Int          @default(0)
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  moverCompany   MoverCompany @relation(fields: [moverCompanyId], references: [id], onDelete: Cascade)

  @@index([moverCompanyId, phone, createdAt])
  @@index([expiresAt, consumedAt])
}

model VerificationAudit {
  id             String       @id @default(cuid())
  moverCompanyId String
  documentId     String?
  actorId        String?
  actorType      String
  action         String
  previousStatus String?
  nextStatus     String?
  reason         String?      @db.Text
  meta           Json?
  createdAt      DateTime     @default(now())
  moverCompany   MoverCompany @relation(fields: [moverCompanyId], references: [id], onDelete: Cascade)

  @@index([moverCompanyId, createdAt])
  @@index([documentId, createdAt])
  @@index([action, createdAt])
}

model QuoteRequest {
  id                        String                   @id @default(cuid())
  submissionKey             String?                  @unique
  name                      String
  email                     String
  phone                     String
  movingWhat                String?
  fromPropertyType          String
  toPropertyType            String
  bedrooms                  String
  fromAddress               String
  fromCity                  String
  fromRegion                String
  fromPostcode              String
  fromCountry               String
  toAddress                 String
  toCity                    String
  toRegion                  String
  toPostcode                String
  toCountry                 String
  moveDate                  DateTime?
  dateFlexible              Boolean                  @default(false)
  transcriptRaw             Json?
  transcriptFields          Json?
  transcriptionState        String?
  sharingConsentAt          DateTime?
  consentVersion            String?
  submittedLocale           String                   @default("en-NZ")
  createdAt                 DateTime                 @default(now())
  leads                     Lead[]
  movingDistributedAt       DateTime?
  inventory                 Json?
  toBedrooms                String?
  customerAccess            CustomerRequestAccess[]
  supportRequests           CustomerRequestSupport[]
  cleaningRequest           CleaningRequest?
  spreadsheetDelivery       LeadSpreadsheetDelivery?
  recruitmentSharingAllowed Boolean                  @default(false)
  outreachMessages          OutreachMessage[]
  recruitmentTasks          RecruitmentTask[]

  @@index([createdAt])
}

model CleaningRequest {
  id                   String           @id @default(cuid())
  quoteRequestId       String           @unique
  location             CleaningLocation @default(MOVE_OUT)
  services             String[]         @default([])
  targetAddress        String?
  targetCity           String?
  targetRegion         String?
  targetPostcode       String?
  propertyType         String?
  bedrooms             String?
  preferredDate        DateTime?
  timeWindow           String?
  propertyEmpty        String?
  moverTiming          String?
  accessNotes          String?          @db.Text
  carpetRooms          Int?
  destinationConsentAt DateTime?
  notes                String?          @db.Text
  consentAt            DateTime
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  quoteRequest         QuoteRequest     @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  leads                CleaningLead[]

  @@index([createdAt])
}

model CleaningLead {
  id                String                 @id @default(cuid())
  cleaningRequestId String
  cleanerCompanyId  String
  status            CleaningLeadStatus     @default(NEW)
  price             Int                    @default(1500)
  viewedAt          DateTime?
  purchasedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  cleaningRequest   CleaningRequest        @relation(fields: [cleaningRequestId], references: [id], onDelete: Cascade)
  cleanerCompany    CleanerCompany         @relation(fields: [cleanerCompanyId], references: [id])
  purchase          CleaningLeadPurchase?
  auditLogs         CleaningLeadAuditLog[]

  @@unique([cleaningRequestId, cleanerCompanyId])
  @@index([cleanerCompanyId, createdAt])
  @@index([cleanerCompanyId, status])
}

model CleaningLeadPurchase {
  id                 String              @id @default(cuid())
  cleaningLeadId     String              @unique
  cleanerCompanyId   String
  invoiceId          String
  amount             Int
  currency           String              @default("NZD")
  billingPeriodKey   String
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  status             CleanerChargeStatus @default(PENDING)
  purchasedAt        DateTime            @default(now())
  createdAt          DateTime            @default(now())
  cleaningLead       CleaningLead        @relation(fields: [cleaningLeadId], references: [id], onDelete: Restrict)
  cleanerCompany     CleanerCompany      @relation(fields: [cleanerCompanyId], references: [id], onDelete: Restrict)
  invoice            CleanerInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([cleanerCompanyId, cleaningLeadId])
  @@index([cleanerCompanyId, billingPeriodKey])
  @@index([invoiceId, purchasedAt])
  @@index([status, billingPeriodEnd])
}

model CleanerInvoice {
  id               String                 @id @default(cuid())
  cleanerCompanyId String
  periodKey        String
  periodStart      DateTime
  periodEnd        DateTime
  leadCount        Int                    @default(0)
  subtotal         Int                    @default(0)
  gstAmount        Int?
  total            Int                    @default(0)
  currency         String                 @default("NZD")
  status           CleanerInvoiceStatus   @default(UPCOMING)
  stripeInvoiceId  String?                @unique
  invoiceNumber    String?                @unique
  hostedInvoiceUrl String?
  invoicePdfUrl    String?
  issuedAt         DateTime?
  sentAt           DateTime?
  dueAt            DateTime?
  paidAt           DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  cleanerCompany   CleanerCompany         @relation(fields: [cleanerCompanyId], references: [id], onDelete: Restrict)
  purchases        CleaningLeadPurchase[]

  @@unique([cleanerCompanyId, periodKey])
  @@index([status, periodEnd])
  @@index([cleanerCompanyId, createdAt])
}

model CleaningLeadAuditLog {
  id             String       @id @default(cuid())
  cleaningLeadId String
  action         String
  meta           Json?
  createdAt      DateTime     @default(now())
  cleaningLead   CleaningLead @relation(fields: [cleaningLeadId], references: [id], onDelete: Cascade)

  @@index([cleaningLeadId, createdAt])
  @@index([action, createdAt])
}

model LeadSpreadsheetDelivery {
  id             String                    @id @default(cuid())
  quoteRequestId String                    @unique
  status         SpreadsheetDeliveryStatus @default(QUEUED)
  attempts       Int                       @default(0)
  maxAttempts    Int                       @default(10)
  nextAttemptAt  DateTime                  @default(now())
  syncedAt       DateTime?
  lastError      String?                   @db.Text
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  quoteRequest   QuoteRequest              @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
}

model Lead {
  id                  String              @id @default(cuid())
  quoteRequestId      String
  moverCompanyId      String
  status              LeadStatus          @default(NEW)
  price               Int
  purchasedAt         DateTime?
  expiresAt           DateTime?
  reminderSentAt      DateTime?
  expiredAt           DateTime?
  redistributedAt     DateTime?
  redistributionRound Int                 @default(0)
  createdAt           DateTime            @default(now())
  quoteRequest        QuoteRequest        @relation(fields: [quoteRequestId], references: [id])
  moverCompany        MoverCompany        @relation(fields: [moverCompanyId], references: [id])
  payment             Payment?
  auditLogs           AuditLog[]
  review              Review?
  reviewSurveyInvite  ReviewSurveyInvite?
  pushDeliveries      MoverPushDelivery[]

  @@index([quoteRequestId])
  @@index([moverCompanyId, createdAt])
  @@index([moverCompanyId, status])
  @@index([status, expiresAt])
  @@index([reminderSentAt, createdAt])
}

model MoverPushSubscription {
  id             String              @id @default(cuid())
  moverCompanyId String
  endpoint       String              @unique
  p256dh         String
  auth           String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  moverCompany   MoverCompany        @relation(fields: [moverCompanyId], references: [id], onDelete: Cascade)
  deliveries     MoverPushDelivery[]

  @@index([moverCompanyId])
}

model MoverPushDelivery {
  id             String                @id @default(cuid())
  dedupeKey      String                @unique
  subscriptionId String
  leadId         String?
  kind           String                @default("LEAD")
  status         String                @default("QUEUED")
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime              @default(now())
  expiresAt      DateTime
  sentAt         DateTime?
  lastError      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  subscription   MoverPushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  lead           Lead?                 @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([leadId])
}

model Review {
  id                     String                 @id @default(cuid())
  moverCompanyId         String
  leadId                 String                 @unique
  reviewSurveyInviteId   String?                @unique
  overallRating          Int
  communicationRating    Int?
  punctualityRating      Int?
  careOfBelongingsRating Int?
  professionalismRating  Int?
  valueForMoneyRating    Int?
  providerResponse       String?                @db.Text
  responseSubmittedAt    DateTime?
  responseApprovedAt     DateTime?
  reports                ReviewReport[]
  writtenReview          String?                @db.Text
  recommendMover         Boolean?
  showReviewerName       Boolean                @default(true)
  moderationStatus       ReviewModerationStatus @default(PENDING)
  isPublic               Boolean                @default(false)
  submittedAt            DateTime               @default(now())
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  moverCompany           MoverCompany           @relation(fields: [moverCompanyId], references: [id], onDelete: Cascade)
  lead                   Lead                   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  reviewSurveyInvite     ReviewSurveyInvite?    @relation(fields: [reviewSurveyInviteId], references: [id], onDelete: SetNull)

  @@index([moverCompanyId, moderationStatus, isPublic, submittedAt])
}

model ReviewSurveyInvite {
  id             String       @id @default(cuid())
  moverCompanyId String
  leadId         String       @unique
  tokenHash      String       @unique
  customerName   String
  customerEmail  String
  expiresAt      DateTime
  sentAt         DateTime?
  consumedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  moverCompany   MoverCompany @relation(fields: [moverCompanyId], references: [id], onDelete: Cascade)
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  review         Review?

  @@index([moverCompanyId, expiresAt])
}

model PricingRule {
  id               String @id @default(cuid())
  name             String
  baseLeadPrice    Int
  bedroomModifier  Int    @default(1000)
  urgentModifier   Int    @default(2000)
  distanceModifier Int    @default(2000)
}

model PlatformSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model Payment {
  id                    String        @id @default(cuid())
  leadId                String        @unique
  stripePaymentIntentId String?
  stripeCheckoutId      String?
  stripeChargeId        String?
  receiptUrl            String?
  amount                Int
  status                PaymentStatus @default(PENDING)
  createdAt             DateTime      @default(now())
  lead                  Lead          @relation(fields: [leadId], references: [id])

  @@index([status, createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  leadId    String
  action    String
  meta      Json?
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id])

  @@index([leadId, createdAt])
}

model AuthToken {
  id         String        @id @default(cuid())
  userId     String
  type       AuthTokenType
  tokenHash  String        @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model EmailDelivery {
  id                String              @id @default(cuid())
  dedupeKey         String?             @unique
  kind              String
  recipient         String
  from              String
  replyTo           String?
  subject           String
  text              String              @db.Text
  html              String              @db.Text
  status            EmailDeliveryStatus @default(QUEUED)
  attempts          Int                 @default(0)
  maxAttempts       Int                 @default(5)
  nextAttemptAt     DateTime            @default(now())
  sentAt            DateTime?
  lastError         String?             @db.Text
  providerMessageId String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status, nextAttemptAt])
  @@index([recipient, createdAt])
  @@index([kind, status])
}

enum AdminRole {
  OWNER
  RECRUITMENT_ADMIN
}

enum RecruitmentStatus {
  NOT_CONTACTED
  CONTACTED
  FOLLOW_UP_REQUIRED
  INTERESTED
  REGISTRATION_STARTED
  REGISTERED
  ACTIVE_MOVER
  NOT_INTERESTED
  DO_NOT_CONTACT
}

model AdminInvitation {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String
  role        AdminRole @default(RECRUITMENT_ADMIN)
  tokenHash   String?   @unique
  expiresAt   DateTime?
  acceptedAt  DateTime?
  revokedAt   DateTime?
  invitedById String?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model MoverProspect {
  id                  String                @id @default(cuid())
  companyName         String
  normalizedName      String
  email               String?               @unique
  emailAvailability   String?
  phoneAvailability   String?
  contactName         String?
  phone               String?
  website             String?
  operatingRegion     String?
  serviceAreas        String[]
  serviceTypes        String[]
  longDistance        Boolean               @default(false)
  assignedAdminId     String
  assignedAdmin       User                  @relation(fields: [assignedAdminId], references: [id], onDelete: Restrict)
  status              RecruitmentStatus     @default(NOT_CONTACTED)
  consentBasis        String                @default("UNKNOWN")
  consentEvidence     String?               @db.Text
  consentRecordedAt   DateTime?
  consentRecordedBy   String?
  notes               String?               @db.Text
  version             Int                   @default(0)
  lastContactedAt     DateTime?
  nextFollowUpAt      DateTime?
  respondedAt         DateTime?
  interestedAt        DateTime?
  registeredAt        DateTime?
  activatedAt         DateTime?
  firstPaidLeadAt     DateTime?
  recruitedById       String?
  moverCompanyId      String?               @unique
  moverCompany        MoverCompany?         @relation(fields: [moverCompanyId], references: [id], onDelete: Restrict)
  duplicateOfId       String?
  duplicateReviewNote String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  messages            OutreachMessage[]
  tasks               RecruitmentTask[]
  activities          RecruitmentActivity[]

  @@index([assignedAdminId, status, nextFollowUpAt])
  @@index([normalizedName])
  @@index([recruitedById, registeredAt])
}

model OutreachMessage {
  id                    String        @id @default(cuid())
  prospectId            String
  prospect              MoverProspect @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  quoteRequestId        String?
  quoteRequest          QuoteRequest? @relation(fields: [quoteRequestId], references: [id], onDelete: Restrict)
  adminId               String
  sequence              Int           @default(0)
  followUpToId          String?       @unique
  admin                 User          @relation(fields: [adminId], references: [id], onDelete: Restrict)
  status                String        @default("DRAFT")
  subject               String
  introduction          String        @db.Text
  text                  String        @db.Text
  html                  String        @db.Text
  attributionHash       String        @unique
  attributionExpiresAt  DateTime
  attributionConsumedAt DateTime?
  unsubscribeHash       String        @unique
  emailDeliveryId       String?       @unique
  approvedAt            DateTime?
  sentAt                DateTime?
  failedAt              DateTime?
  lastError             String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([prospectId, quoteRequestId, sequence])
  @@index([adminId, sentAt])
  @@index([status, createdAt])
}

model RecruitmentTask {
  id              String         @id @default(cuid())
  dedupeKey       String?        @unique
  title           String
  description     String?        @db.Text
  assignedAdminId String
  assignedAdmin   User           @relation(fields: [assignedAdminId], references: [id], onDelete: Restrict)
  prospectId      String?
  prospect        MoverProspect? @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  quoteRequestId  String?
  quoteRequest    QuoteRequest?  @relation(fields: [quoteRequestId], references: [id], onDelete: Restrict)
  priority        String         @default("NORMAL")
  dueAt           DateTime
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime       @default(now())

  @@index([assignedAdminId, completedAt, dueAt])
}

model RecruitmentActivity {
  id         String        @id @default(cuid())
  prospectId String
  prospect   MoverProspect @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  actorId    String?
  action     String
  meta       Json?
  createdAt  DateTime      @default(now())

  @@index([prospectId, createdAt])
  @@index([actorId, action, createdAt])
}

model ContactSuppression {
  email     String   @id
  reason    String
  source    String
  createdAt DateTime @default(now())
}

model RecruitmentSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model RecruitmentProviderEvent {
  id        String   @id
  type      String
  email     String
  createdAt DateTime @default(now())
}

model QuoteDraft {
  id            String   @id @default(cuid())
  tokenHash     String   @unique
  encryptedData String   @db.Text
  expiresAt     DateTime
  updatedAt     DateTime @updatedAt

  @@index([expiresAt])
}

model CustomerRequestAccess {
  id             String       @id @default(cuid())
  tokenHash      String       @unique
  quoteRequestId String
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([quoteRequestId])
  @@index([expiresAt])
}

model CustomerRequestSupport {
  id             String       @id @default(cuid())
  quoteRequestId String
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Restrict)
  message        String       @db.Text
  status         String       @default("OPEN")
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([status, createdAt])
}

model ReviewReport {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reason    String   @db.Text
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

model ConversionEvent {
  id        String   @id
  name      String
  source    String?
  step      Int?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}
